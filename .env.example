ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Optional: which built-in Voice Agent API voice to use.
EV_VOICE=ivy

# Optional: mirror newly-added tasks into an existing Notion database
# (e.g. your Hackathon Command Center). Leave blank to skip Notion entirely --
# the agent works fully offline with local JSON storage either way.
NOTION_API_KEY=
NOTION_TASKS_DB_ID=

# Optional: enables the read_screen tool (screenshot Q&A) via Claude's
# vision API. Get a key at https://console.anthropic.com/. Leave blank and
# read_screen will just say it's not set up, instead of crashing.
ANTHROPIC_API_KEY=

# Optional: override which Claude model read_screen uses (defaults to a
# fast/cheap Haiku model).
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001
